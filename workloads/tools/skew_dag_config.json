  "variants": [
    {
      "name": "skew_dag",
      "task_id": 900,
      "workload_name": "skew_dag",
      "description": "Skinny–wide–skinny DAG modeling a KV read path with a skewed lookup stage.\nparse_req and hash_key fan into a dominant db_lookup node (skewable via\nservice_profile), while auth_check joins before serialize_resp to stress\ndependency pressure.",
      "metadata": {
        "workload_label": "skew_dag",
        "arrival_model": "dag-burst",
        "zipf_alpha": "1.0"
      },
      "batch_runs": [
        {
          "name": "dag-prefer-host",
          "policy": "prefer-host",
          "metadata": {
            "placement": "host"
          }
        },
        {
          "name": "dag-prefer-nic",
          "policy": "prefer-nic",
          "metadata": {
            "placement": "nic"
          }
        }
      ],
      "scenarios": [
        {
          "name": "baseline",
          "arrival": "workloads/arrivals/poisson_bursty.yaml",
          "arrival_scales": [1.0],
          "seeds": [1],
          "placement_modes": ["host_pinned", "nic_pinned"],
          "metadata": {
            "arrival_label": "baseline"
          }
        },
        {
          "name": "stress",
          "arrival": "workloads/arrivals/poisson_bursty.yaml",
